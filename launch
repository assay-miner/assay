#!/usr/bin/env bash
# Deploys the ASSAY stack. One command, no addresses to paste: the ERC-8004 registry is
# derived from the chain id inside the script and every deployed address is chained
# forward through deployments/<chainid>-latest.json.
set -euo pipefail
cd "$(dirname "$0")"
export PATH="$HOME/.foundry/bin:$PATH"

CHAIN_ID="${CHAIN_ID:-97}"
RPC="${RPC_URL:-}"
if [ -z "$RPC" ]; then
  case "$CHAIN_ID" in
    97) RPC="https://bsc-testnet-rpc.publicnode.com" ;;
    56) RPC="https://bsc-dataseed.binance.org" ;;
    *)  echo "unsupported CHAIN_ID=$CHAIN_ID (use 56 or 97)" >&2; exit 1 ;;
  esac
fi

# An unset variable and a variable set to the empty string are the same failure here, and
# ${X:-} would happily hand the empty string to forge. Check for emptiness explicitly.
if [ -z "${PRIVATE_KEY:-}" ]; then
  echo "PRIVATE_KEY is empty or unset. Export it and re-run." >&2
  exit 1
fi

echo "chain    $CHAIN_ID"
echo "rpc      $RPC"
echo "deployer $(cast wallet address --private-key "$PRIVATE_KEY")"
echo "balance  $(cast balance "$(cast wallet address --private-key "$PRIVATE_KEY")" --rpc-url "$RPC")"

# Mine the vanity salt here, outside the broadcast. It is pure but takes hundreds of thousands of
# address predictions, and run inside the simulation it holds a fork open for minutes — long enough
# that a public BSC node prunes the block out from under it and the deploy dies with
# `missing trie node`, which reads like a bug in this script and is not one.
if [ -z "${SALT:-}" ]; then
  SALT="$(CHAIN="$CHAIN_ID" SALT_OFFSET="${SALT_OFFSET:-$(date +%s)}" \
    forge script script/MineSalt.s.sol:MineSalt --sig 'mine()' 2>/dev/null \
    | awk '/SALT /{print $NF}')"
  [ -n "$SALT" ] || { echo "could not mine a vanity salt" >&2; exit 1; }
fi
export SALT
echo "salt     $SALT"
echo "token    $(CHAIN="$CHAIN_ID" SALT="$SALT" forge script script/MineSalt.s.sol:MineSalt --sig 'mine()' 2>/dev/null | awk '/token/{print $NF}')"
[ "${SKIP_TOKEN:-}" = "true" ] && echo "         (SKIP_TOKEN=true — the stack only; no token is launched)"

# -g pads the gas estimate. An estimate that is merely accurate is not enough on a chain whose
# broadcast conditions differ from the simulation's. --slow is deliberately not used: waiting for
# each receipt keeps the fork open past the window a public node will serve.
forge script script/Deploy.s.sol:Deploy \
  --rpc-url "$RPC" --broadcast -g "${GAS_MULT:-130}" "$@"

MANIFEST="deployments/${CHAIN_ID}-latest.json"
echo
echo "manifest $MANIFEST"
cat "$MANIFEST"

# Chain the addresses into the frontend rather than asking anyone to copy them.
# jq prints the string "null" for a key that is absent and the zero address for one that was
# skipped; neither is an address, and either would make the site read a contract that is not
# there. Write the key only when there is something real behind it.
FLAP_VAULT="$(jq -r '.flapVault // ""' "$MANIFEST")"
case "$FLAP_VAULT" in
  0x0000000000000000000000000000000000000000|null|"") FLAP_VAULT="" ;;
esac

{
  echo "VITE_CHAIN_ID=$CHAIN_ID"
  echo "VITE_TOURNAMENT=$(jq -r .tournament "$MANIFEST")"
  echo "VITE_ROSTER=$(jq -r .roster "$MANIFEST")"
  echo "VITE_VAULT=$(jq -r .vault "$MANIFEST")"
  echo "VITE_TOKEN=$(jq -r .taxToken "$MANIFEST")"
  [ -n "$FLAP_VAULT" ] && echo "VITE_FLAP_VAULT=$FLAP_VAULT"
} > app/.env.local
echo
echo "wrote app/.env.local:"
cat app/.env.local
echo
echo "NOTE: a hosted build reads the HOST's environment variables, not this file."
echo "      Set the same ones in the hosting dashboard before deploying the site."
