#!/usr/bin/env bash
# Takes every recoverable token back to the deployer. Runs immediately: no dry run, no
# confirmation word, no preview. Each task is reclaimed independently so one that is still
# inside its claim window cannot block the rest.
set -euo pipefail
cd "$(dirname "$0")"
export PATH="$HOME/.foundry/bin:$PATH"

CHAIN_ID="${CHAIN_ID:-97}"
RPC="${RPC_URL:-}"
if [ -z "$RPC" ]; then
  case "$CHAIN_ID" in
    97) RPC="https://bsc-testnet-rpc.publicnode.com" ;;
    56) RPC="https://bsc-dataseed.binance.org" ;;
  esac
fi
if [ -z "${PRIVATE_KEY:-}" ]; then echo "PRIVATE_KEY is empty or unset." >&2; exit 1; fi

MANIFEST="deployments/${CHAIN_ID}-latest.json"
[ -s "$MANIFEST" ] || { echo "no manifest at $MANIFEST — nothing was ever deployed here" >&2; exit 1; }

export TOURNAMENT="$(jq -r .tournament "$MANIFEST")"
export TOKEN="$(jq -r .token "$MANIFEST")"
echo "tournament $TOURNAMENT"
echo "token      $TOKEN"

forge script script/Exit.s.sol:ExitAll \
  --rpc-url "$RPC" --broadcast -g 300 --slow "$@"
