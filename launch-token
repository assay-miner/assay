#!/usr/bin/env bash
# Launches the tax token through the factory ./launch already deployed, and chains the two new
# addresses back into the manifest so nothing downstream has to be pasted.
#
# Separate from ./launch on purpose. The factory is the audited artifact; redeploying it to change
# a launch parameter throws away the address an auditor verified. A launch parameter belongs to the
# launch, so this reuses the factory and only does the part that has to be new.
set -euo pipefail
cd "$(dirname "$0")"
export PATH="$HOME/.foundry/bin:$PATH"

CHAIN_ID="${CHAIN_ID:-97}"
RPC="${RPC_URL:-}"
if [ -z "$RPC" ]; then
  case "$CHAIN_ID" in
    97) RPC="https://bsc-testnet-rpc.publicnode.com" ;;
    56) RPC="https://bsc-dataseed.binance.org" ;;
    *)  echo "unsupported CHAIN_ID=$CHAIN_ID (use 56 or 97)" >&2; exit 1 ;;
  esac
fi
if [ -z "${PRIVATE_KEY:-}" ]; then echo "PRIVATE_KEY is empty or unset." >&2; exit 1; fi

MANIFEST="deployments/${CHAIN_ID}-latest.json"
[ -s "$MANIFEST" ] || { echo "no manifest at $MANIFEST — run ./launch first" >&2; exit 1; }

FACTORY="$(jq -r '.flapFactory // ""' "$MANIFEST")"
case "$FACTORY" in
  0x0000000000000000000000000000000000000000|null|"")
    echo "the manifest has no factory — run ./launch first" >&2; exit 1 ;;
esac

# A token already recorded here means this would launch a second one and overwrite the first in the
# manifest, leaving the first unreachable. Refuse rather than do that quietly.
EXISTING="$(jq -r '.taxToken // ""' "$MANIFEST")"
case "$EXISTING" in
  0x0000000000000000000000000000000000000000|null|"") ;;
  *) echo "$MANIFEST already records a token at $EXISTING." >&2
     echo "Launching again would overwrite it and strand the first one." >&2
     echo "Move that manifest aside first if a second launch is really intended." >&2
     exit 1 ;;
esac

export TOKEN_NAME="${TOKEN_NAME:-Assay}"
export TOKEN_SYMBOL="${TOKEN_SYMBOL:-ASSAY}"
export DEV_BUY_WEI="${DEV_BUY_WEI:-0}"

echo "chain     $CHAIN_ID"
echo "factory   $FACTORY"
echo "token     $TOKEN_NAME ($TOKEN_SYMBOL)"
echo "dev buy   $(cast from-wei "$DEV_BUY_WEI") BNB"
echo "deployer  $(cast wallet address --private-key "$PRIVATE_KEY")"
echo "balance   $(cast from-wei "$(cast balance "$(cast wallet address --private-key "$PRIVATE_KEY")" --rpc-url "$RPC")") BNB"

# Mine the vanity salt outside the broadcast. It is pure but takes hundreds of thousands of address
# predictions, and held inside the simulation it keeps a fork open long enough that a public BSC
# node prunes the block out from under it — the launch then dies with `missing trie node`, which
# reads like a bug in this script and is not one.
if [ -z "${SALT:-}" ]; then
  SALT="$(CHAIN="$CHAIN_ID" SALT_OFFSET="${SALT_OFFSET:-$(date +%s)}" \
    forge script script/MineSalt.s.sol:MineSalt --sig 'mine()' 2>/dev/null \
    | awk '/SALT /{print $NF}')"
  [ -n "$SALT" ] || { echo "could not mine a vanity salt" >&2; exit 1; }
fi
export SALT
echo "salt      $SALT"

forge script script/LaunchToken.s.sol:LaunchToken \
  --rpc-url "$RPC" --broadcast -g "${GAS_MULT:-130}" "$@"

echo
echo "manifest $MANIFEST"
jq '{taxToken, flapVault, flapFactory, tournament}' "$MANIFEST"
